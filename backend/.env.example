# GESTOCK · Recepción Inteligente IoT — variables de entorno
# Copia este archivo a `.env` y ajusta los valores.
#   Windows:  copy .env.example .env
#   Linux/mac: cp .env.example .env
#
# `.env` NUNCA debe subirse al repositorio.

# ---------------------------------------------------------------------------
# Servidor HTTP
# ---------------------------------------------------------------------------
PORT=8080

# Orígenes permitidos (CORS) separados por coma. Usa * solo en desarrollo.
CORS_ORIGINS=http://localhost:4200,http://localhost:4300

# ---------------------------------------------------------------------------
# EMQX Cloud (MQTT)
# ---------------------------------------------------------------------------
# Si MQTT_BROKER_URL queda vacío, el backend arranca en MODO SIMULACIÓN
# (emula al ESP32) para poder demostrar el flujo sin hardware.
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=gestock_backend

MQTT_TOPIC_SENSOR=gestock/recepcion/sensor
MQTT_TOPIC_CLASIFICADOR=gestock/recepcion/clasificador
MQTT_TOPIC_ESTADO=gestock/recepcion/estado

# Retardo (ms) con el que el ESP32 simulado confirma una clasificación.
MQTT_SIMULACION_DELAY_MS=1200
